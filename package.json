{
  "name": "@getenergy/gke-sandboxes",
  "version": "0.5.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.4.4"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "description": "Run persistent, isolated workspaces on your own GKE cluster.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/comp-work/gke-sandboxes.git"
  },
  "homepage": "https://github.com/comp-work/gke-sandboxes#readme",
  "keywords": [
    "gke",
    "gvisor",
    "sandbox",
    "agents",
    "kubernetes"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "packageManager": "bun@1.4.4",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "test": "bun test ./src",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "typescript": "^7.0.2"
  }
